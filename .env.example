# ==============================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL (Recomendado: Neon o Supabase)
# ==============================================================
# Pega aquí tu cadena de conexión PostgreSQL.
# Por ejemplo, obtenida gratis en https://neon.tech o https://supabase.com :
#
DATABASE_URL="postgresql://neondb_owner:npg_xxxxxx@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Si dejas DATABASE_URL vacío, la app usará automáticamente SQLite local (data/rentas.db)

# Puerto del servidor backend en desarrollo local
PORT=3001
